{
	"luci-app-airhand": {
		"description": "Grant access to Airhand remote desktop",
		"read": {
			"ubus": {
				"service": [ "list" ]
			},
			"uci": [ "airhand" ]
		},
		"write": {
			"uci": [ "airhand", "firewall" ],
			"file": {
				"/etc/init.d/airhand-server": [ "exec" ],
				"/etc/init.d/airhand-web": [ "exec" ],
				"/usr/libexec/airhand/fingerprint.sh": [ "exec" ],
				"/usr/libexec/airhand/wan-expose.sh": [ "exec" ]
			}
		}
	}
}
