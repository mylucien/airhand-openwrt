config airhand 'relay'
	option enabled '1'
	option listen '0.0.0.0:4433'
	option max_sessions '4'
	option cert_names 'airhand,localhost'
	option log_level 'info'
	option data_dir '/etc/airhand/relay'

config airhand 'web'
	option enabled '1'
	option listen '0.0.0.0:8080'
	option relay '127.0.0.1:4433'
	option server_fp ''
	option name 'Airhand Web'
	option password ''
	option cert_names ''
	option log_level 'info'
	option data_dir '/etc/airhand/web'
