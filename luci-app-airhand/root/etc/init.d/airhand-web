#!/bin/sh /etc/rc.common
# Airhand 网页控制台：TCP 8080，同一个端口同时支持 HTTP 和 HTTPS。
# 启动后浏览器打开 http://<路由器地址>:8080 即可（从别的电脑访问要用 https://）。

START=91
STOP=10
USE_PROCD=1

PROG=/usr/bin/airhand-web
WWW=/usr/share/airhand/www

start_service() {
	local enabled listen relay server_fp name password cert_names data_dir log_level

	config_load airhand
	config_get_bool enabled web enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get listen web listen '0.0.0.0:8080'
	config_get relay web relay '127.0.0.1:4433'
	config_get server_fp web server_fp ''
	config_get name web name 'Airhand Web'
	config_get password web password ''
	config_get cert_names web cert_names ''
	config_get data_dir web data_dir '/etc/airhand/web'
	config_get log_level web log_level 'info'

	if [ ! -f "$WWW/index.html" ]; then
		logger -t airhand-web "缺少 $WWW/index.html，网页控制台无法启动"
		return 1
	fi

	mkdir -p "$data_dir" || return 1

	procd_open_instance 'web'
	procd_set_param command "$PROG"
	procd_set_param env \
		AIRHAND_WEB_LISTEN="$listen" \
		AIRHAND_WEB_ROOT="$WWW" \
		AIRHAND_WEB_CERT="$data_dir/cert.pem" \
		AIRHAND_WEB_KEY="$data_dir/key.pem" \
		AIRHAND_WEB_IDENTITY="$data_dir/controller-key.txt" \
		AIRHAND_SERVER_TRUST="$data_dir/server-trust.txt" \
		AIRHAND_SERVER="$relay" \
		AIRHAND_SERVER_FP="$server_fp" \
		AIRHAND_NAME="$name" \
		AIRHAND_WEB_PASSWORD="$password" \
		AIRHAND_WEB_CERT_NAMES="$cert_names" \
		RUST_LOG="$log_level"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger 'airhand'
}
