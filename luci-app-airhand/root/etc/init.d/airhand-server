#!/bin/sh /etc/rc.common
# Airhand 中继服务器：QUIC，UDP 4433。
# 只负责分配控制码和转发字节，端到端加密在两端完成，服务器看不到画面。

START=90
STOP=10
USE_PROCD=1

PROG=/usr/bin/airhand-server

start_service() {
	local enabled listen data_dir max_sessions cert_names log_level

	config_load airhand
	config_get_bool enabled relay enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get listen relay listen '0.0.0.0:4433'
	config_get data_dir relay data_dir '/etc/airhand/relay'
	config_get max_sessions relay max_sessions '4'
	config_get cert_names relay cert_names 'airhand,localhost'
	config_get log_level relay log_level 'info'

	mkdir -p "$data_dir" || return 1

	procd_open_instance 'relay'
	procd_set_param command "$PROG"
	procd_set_param env \
		AIRHAND_LISTEN="$listen" \
		AIRHAND_CERT="$data_dir/cert.pem" \
		AIRHAND_KEY="$data_dir/key.pem" \
		AIRHAND_DB="$data_dir/airhand.db" \
		AIRHAND_CERT_NAMES="$cert_names" \
		AIRHAND_MAX_SESSIONS="$max_sessions" \
		RUST_LOG="$log_level"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger 'airhand'
}
